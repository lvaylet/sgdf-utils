# ==============================================================================
# Configuration direnv - Automatisation SGDF La Rochelle (Contacts Parents)
# ==============================================================================
# Ce fichier active automatiquement l'environnement de développement éphémère
# Python 3 à chaque entrée dans le dossier, avec deux options en parallèle :
#   1. Nix Flakes (`flake.nix`) — Option prioritaire par défaut
#   2. Jetify Devbox (`devbox.json`) — Option de repli ou sur demande
#
# Pour forcer le choix de l'outil sans modifier ce fichier :
#   - Définir `OUTIL_ENVIRONNEMENT=flake` ou `OUTIL_ENVIRONNEMENT=devbox`
#   - Ou créer un fichier `.envrc.local` contenant `export OUTIL_ENVIRONNEMENT=devbox`
# ==============================================================================

# Charger les préférences locales éventuelles du bénévole (ignorées par Git)
source_env_if_exists .envrc.local

outil_choisi="${OUTIL_ENVIRONNEMENT:-auto}"

activer_option_flake() {
    watch_file flake.nix flake.lock
    echo "direnv (SGDF La Rochelle) : Activation de l'environnement éphémère via Nix Flake (flake.nix)..."
    use flake path:.
}

activer_option_devbox() {
    watch_file devbox.json
    echo "direnv (SGDF La Rochelle) : Activation de l'environnement éphémère via Jetify Devbox (devbox.json)..."
    eval "$(devbox generate direnv --print-envrc)"
}

case "$outil_choisi" in
    auto)
        if has nix; then
            activer_option_flake
        elif has devbox; then
            activer_option_devbox
        else
            echo "Erreur (SGDF La Rochelle) : Aucun gestionnaire d'environnement éphémère détecté." >&2
            echo "Veuillez installer Nix (avec flakes activés) ou Jetify Devbox sur cette machine." >&2
        fi
        ;;
    flake)
        if has nix; then
            activer_option_flake
        else
            echo "Erreur (SGDF La Rochelle) : OUTIL_ENVIRONNEMENT=flake a été demandé, mais la commande 'nix' est introuvable." >&2
        fi
        ;;
    devbox)
        if has devbox; then
            activer_option_devbox
        else
            echo "Erreur (SGDF La Rochelle) : OUTIL_ENVIRONNEMENT=devbox a été demandé, mais la commande 'devbox' est introuvable." >&2
        fi
        ;;
    *)
        echo "Erreur (SGDF La Rochelle) : Valeur OUTIL_ENVIRONNEMENT='$outil_choisi' invalide." >&2
        echo "Valeurs autorisées : 'auto' (défaut), 'flake' (flake.nix) ou 'devbox' (devbox.json)." >&2
        ;;
esac
