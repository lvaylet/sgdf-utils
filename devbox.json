{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": [
    "python3@latest",
    "python3Packages.pandas@latest",
    "python3Packages.beautifulsoup4@latest",
    "python3Packages.lxml@latest",
    "python3Packages.xlrd@latest",
    "python3Packages.openpyxl@latest",
    "python3Packages.sqlmodel@latest",
    "python3Packages.sqlalchemy@latest",
    "python3Packages.pytest@latest",
    "ruff@latest"
  ],
  "shell": {
    "init_hook": [
      "echo '=================================================================='",
      "echo ' Environnement éphémère SGDF La Rochelle actif (option : devbox.json)'",
      "echo \" Interpréteur : $(python3 --version)\"",
      "echo ' Outils prêts : pandas, beautifulsoup4, lxml, xlrd, openpyxl, sqlmodel, sqlalchemy, pytest, ruff'",
      "echo '=================================================================='"
    ],
    "scripts": {
      "check_environment": [
        "python3 -c \"import pandas, bs4, lxml, xlrd, openpyxl, sqlmodel, sqlalchemy, pytest; print('Vérification réussie : tous les paquets SGDF La Rochelle sont disponibles.')\""
      ],
      "test": [
        "pytest"
      ],
      "check_quality": [
        "ruff check ."
      ]
    }
  }
}
